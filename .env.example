# ════════════════════════════════════════════════════════════════════════════
# Auto News Video — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your real API keys.
# .env.local is gitignored — never commit real keys.

# ── TTS Provider ────────────────────────────────────────────────────────────
# Choose ONE: "lucylab", "elevenlabs", "supertonic", or "vieneu"
# - lucylab    : Vietnamese voice cloning (recommended for VN content), free SRT
# - elevenlabs : multilingual, more voice options, higher quality but pricier
# - supertonic : local/offline ONNX TTS, no cloud quota, no SRT
# - vieneu     : high-quality Vietnamese TTS with voice cloning, local or remote
TTS_PROVIDER=lucylab

# Optional fallback chain when the primary TTS provider fails or quota is exhausted.
# Comma-separated list. e.g. "supertonic, vieneu"
# Recommended value: supertonic, vieneu
# TTS_FALLBACK_PROVIDER=supertonic, vieneu

# ════════════════════════════════════════════════════════════════════════════
# OPTION 1: LucyLab.io  (https://lucylab.io)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=lucylab
VIETNAMESE_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
VIETNAMESE_VOICEID=22charvoiceiduuidhere

# Optional overrides
LUCYLAB_ENDPOINT=https://api.lucylab.io/json-rpc
LUCYLAB_POLL_INTERVAL_MS=2000
LUCYLAB_POLL_TIMEOUT_MS=120000

# ════════════════════════════════════════════════════════════════════════════
# OPTION 2: ElevenLabs  (https://elevenlabs.io)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=elevenlabs
# Get API key at:  https://elevenlabs.io/app/settings/api-keys
# Browse voices at: https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional model override (default: eleven_multilingual_v2 — supports Vietnamese)
# Other options: eleven_turbo_v2_5 (fastest), eleven_multilingual_v2 (best quality)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_ENDPOINT=https://api.elevenlabs.io/v1

# ════════════════════════════════════════════════════════════════════════════
# OPTION 3: Supertonic local/offline TTS
# ════════════════════════════════════════════════════════════════════════════
# Required once per machine:
#   python3 -m pip install supertonic
#
# Use when:
# - LucyLab/ElevenLabs quota is exhausted
# - you need offline/private rendering
# - you want cheap draft renders before paying for final cloud TTS
SUPERTONIC_PYTHON=python3
SUPERTONIC_SCRIPT=scripts/supertonic_tts.py
SUPERTONIC_VOICE=M4
SUPERTONIC_LANG=vi
SUPERTONIC_SPEED=1.05

# ════════════════════════════════════════════════════════════════════════════
# OPTION 4: VieNeu-TTS  (https://github.com/pnnbao97/VieNeu-TTS)
# ════════════════════════════════════════════════════════════════════════════
# High-quality Vietnamese TTS with instant voice cloning, 24kHz output.
# Required once per machine:
#   pip install vieneu
# For macOS Apple Silicon with Metal GPU acceleration:
#   pip install vieneu --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/metal/
#
# Modes:
#   standard : GGUF + ONNX on-device, highest quality (default)
#   turbo    : CPU-only, fastest, lower quality for short phrases
#   remote   : connects to VieNeu Docker/GPU server
VIENEU_PYTHON=python3
VIENEU_SCRIPT=scripts/vieneu_tts.py
VIENEU_MODE=standard
VIENEU_EMOTION=storytelling

# Voice cloning: provide 3-5 seconds of reference audio
# VIENEU_REF_AUDIO=assets/yokdon-voice.wav
# VIENEU_REF_TEXT=Transcript of reference audio (improves Standard mode accuracy)

# Remote mode: connect to a VieNeu GPU server (Docker)
# VIENEU_REMOTE_API_BASE=http://gpu-server:23333/v1
# VIENEU_REMOTE_MODEL=pnnbao-ump/VieNeu-TTS-v2
# TikTok follow card (outro)
# ════════════════════════════════════════════════════════════════════════════
# Customize the TikTok-style profile card that appears at the end of every video.
# All fields optional — defaults work out of the box.
TIKTOK_DISPLAY_NAME=Quốc Yok Đôn
TIKTOK_HANDLE=@quocyokdon
TIKTOK_FOLLOWERS=11.5k followers

# Optional: URL to your real TikTok avatar image (jpg/png, square, ~256x256+).
# If not set, uses the bundled default avatar at assets/avatar.jpg.
# You can also replace assets/avatar.jpg directly with your own image.
# TIKTOK_AVATAR_URL=https://example.com/your-avatar.jpg

# ── Pipeline tuning ─────────────────────────────────────────────────────────
# TTS_CONCURRENCY: 1 for LucyLab (API limit), can increase for ElevenLabs
TTS_CONCURRENCY=1
# AUTO_SFX is off by default to avoid stray transition sounds in public-service videos.
# Set true only when the script intentionally needs automatic scene SFX.
AUTO_SFX=false

# ── Optional AI image generation for Studio ────────────────────────────────
# If set, the Studio "Tạo ảnh AI" button can generate per-scene images.
# Without this key, use "Tạo ảnh local" for deterministic local SVG assets.
# OPENAI_API_KEY=sk-proj_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low

# ── Optional auto-publish ──────────────────────────────────────────────────
# Default is safe: dry-run only, no real platform posting.
# In Studio you can click "Đăng" after video.mp4 exists.
AUTO_PUBLISH_ON_RENDER=false
AUTO_PUBLISH_PLATFORMS=dry-run

# Generic webhook for n8n / Make / Zapier / your own API.
# Receives multipart form-data: manifest, caption, projectId, video.
# AUTOPUBLISH_WEBHOOK_URL=https://example.com/webhook/auto-video
# AUTOPUBLISH_WEBHOOK_SECRET=

# Facebook Page video upload.
# Requires a Page access token with the app permissions approved by Meta.
FACEBOOK_GRAPH_VERSION=v25.0
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PUBLISHED=true

# YouTube Data API upload.
# Use an OAuth access token for the channel owner.
# Start private by default, then review before public release.
# YOUTUBE_ACCESS_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=22
YOUTUBE_DEFAULT_LANGUAGE=vi

# TikTok Content Posting API inbox upload.
# Depending on your app/scopes/review status, final posting can require
# confirmation inside TikTok after the inbox upload completes.
# TIKTOK_ACCESS_TOKEN=
